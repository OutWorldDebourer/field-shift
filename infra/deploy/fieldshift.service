# Field Shift: one binary serving the web app and the API on 127.0.0.1:8787 (Caddy terminates HTTPS in front).
[Unit]
Description=Field Shift (web app and API)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=fieldshift
Group=fieldshift
# "current" is a symlink to the active release; deploy.sh switches it atomically and restarts this unit.
WorkingDirectory=/opt/fieldshift/current
Environment=FIELDSHIFT_ROOT=/opt/fieldshift/current
Environment=FIELDSHIFT_BIND=127.0.0.1:8787
Environment=RUST_LOG=info
ExecStart=/opt/fieldshift/current/fieldshift
Restart=always
RestartSec=3
# 1 GB VM: keep the app well inside its share; MariaDB and Caddy need the rest.
MemoryMax=450M
# Hardening: read-only system, writable only where the app keeps uploads and caches.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fieldshift/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
