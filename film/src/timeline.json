 "cues": {
  "en": [
   {
    "t0": 0.75,
    "speech_end": 3.3,
    "text": "This is the Huaral valley, from orbit.",
    "t1": 3.85
   },
   {
    "t0": 3.95,
    "speech_end": 6.32,
    "text": "Field Shift dives to one farmer's field.",
    "t1": 6.87
   },
   {
    "t0": 10.35,
    "speech_end": 12.88,
    "text": "The farmer sends photos and NASA data checks them.",
    "t1": 13.43
   },
   {
    "t0": 14.05,
    "speech_end": 17.28,
    "text": "These weeks run 5 °C warmer than the 40-year normal,",
    "t1": 17.58
   },
   {
    "t0": 17.63,
    "speech_end": 19.04,
    "text": "so aphids breed faster.",
    "t1": 19.59
   },
   {
    "t0": 20.75,
    "speech_end": 22.6,
    "text": "Three options, every number cited.",
    "t1": 23.15
   },
   {
    "t0": 23.75,
    "speech_end": 25.52,
    "text": "A pre-diagnosis your agronomist can verify.",
    "t1": 26.07
   }
  ],
  "es": [
   {
    "t0": 0.75,
    "speech_end": 3.47,
    "text": "Este es el valle de Huaral, desde la órbita.",
    "t1": 3.9
   },
   {
    "t0": 3.95,
    "speech_end": 6.62,
    "text": "Field Shift baja hasta el campo de un agricultor.",
    "t1": 7.17
   },
   {
    "t0": 10.35,
    "speech_end": 13.76,
    "text": "El agricultor envía fotos y los datos de la NASA las contrastan.",
    "t1": 14.0
   },
   {
    "t0": 14.05,
    "speech_end": 17.91,
    "text": "Estas semanas están 5 °C más cálidas que la normal de 40 años.",
    "t1": 18.0
   },
   {
    "t0": 18.05,
    "speech_end": 19.88,
    "text": "Los pulgones se multiplican más rápido.",
    "t1": 20.43
   },
   {
    "t0": 20.75,
    "speech_end": 23.32,
    "text": "Tres opciones, cada número con su fuente.",
    "t1": 23.7
   },
   {
    "t0": 23.75,
    "speech_end": 26.01,
    "text": "Un prediagnóstico que tu agrónomo puede verificar.",
    "t1": 26.56
   }
  ]
 }
